# PostgreSQL connection supplied by Render, Neon, or local development.
DATABASE_URL=postgresql://username:password@host:5432/qsign

# Generate a long, random secret for every deployed environment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional one-time demo account seeding. Leave blank when not seeding.
DEMO_USER_PASSWORD=
DEMO_OPERATOR_PASSWORD=
ALLOW_OPERATOR_REGISTRATION=false
